[Unit]
Description=CRSF2 AmneziaWG gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/crsf2-amneziawg
ExecStart=/usr/local/libexec/crsf2-awg-start
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
RuntimeDirectory=amneziawg
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
